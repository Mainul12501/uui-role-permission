{
  "name": "mainul/uui-role-permission",
  "description": "Tenant-aware, UUID-first roles and permissions for Laravel.",
  "keywords": ["laravel", "rbac", "roles", "permissions", "multi-tenant"],
  "homepage": "https://github.com/Mainul12501/uui-role-permission",
  "support": {
    "issues": "https://github.com/Mainul12501/uui-role-permission/issues",
    "source": "https://github.com/Mainul12501/uui-role-permission"
  },
  "archive": {
    "exclude": ["/vendor", "/build", "/composer.lock", "/.phpunit.cache", "/.phpunit.result.cache", "/.idea", "/.vscode"]
  },
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "larastan/larastan": "^2.9|^3.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  },
  "suggest": {
    "laravel/sanctum": "Revoke API tokens when access is removed."
  },
  "autoload": {
    "psr-4": {
      "Mainul\\UuiRolePermission\\": "src/",
      "Mainul\\UuiRolePermission\\Database\\Seeders\\": "database/seeders/",
      "Mainul\\UuiRolePermission\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mainul\\UuiRolePermission\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php -r \"foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator(__DIR__)) as $file) { if ($file->isFile() && $file->getExtension() === 'php' && strpos($file->getPathname(), DIRECTORY_SEPARATOR.'vendor'.DIRECTORY_SEPARATOR) === false) { passthru(PHP_BINARY.' -l '.escapeshellarg($file->getPathname()), $status); if ($status) exit($status); } }\"",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format:test": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": ["Mainul\\UuiRolePermission\\UuiRolePermissionServiceProvider"],
      "aliases": {
        "RolePermission": "Mainul\\UuiRolePermission\\Facades\\RolePermission"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
